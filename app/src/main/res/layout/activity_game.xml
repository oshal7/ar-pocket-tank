<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/charcoal_slate_dark">

    <android.opengl.GLSurfaceView
        android:id="@+id/glSurfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Calibration overlay -->
    <LinearLayout
        android:id="@+id/calibrationOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:id="@+id/scanHintText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel"
            android:padding="16dp"
            android:text="@string/scanning_hint"
            android:textColor="@color/hud_text"
            android:textSize="16sp"
            android:gravity="center" />
    </LinearLayout>

    <!-- Top-center HUD -->
    <LinearLayout
        android:id="@+id/topHud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="20dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_panel"
        android:padding="10dp"
        android:visibility="invisible">

        <TextView
            android:id="@+id/turnText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/your_turn"
            android:textColor="@color/neon_cyan"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/hpText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/hud_text"
            android:textSize="12sp"
            android:text="YOU 100  |  AI 100" />
    </LinearLayout>

    <!-- Radar PiP top-right -->
    <com.pockettanks.ar.ui.RadarView
        android:id="@+id/radarView"
        android:layout_width="140dp"
        android:layout_height="100dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:visibility="invisible" />

    <!-- Bottom-left radial dial (angle) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="16dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible"
        android:id="@+id/dialContainer">

        <TextView
            android:id="@+id/angleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="45°"
            android:textColor="@color/neon_cyan"
            android:textStyle="bold" />

        <com.pockettanks.ar.ui.RadialDialView
            android:id="@+id/radialDialView"
            android:layout_width="130dp"
            android:layout_height="90dp" />
    </LinearLayout>

    <!-- Bottom-right power bar + weapon toggle -->
    <LinearLayout
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:orientation="vertical"
        android:id="@+id/powerContainer">

        <Button
            android:id="@+id/weaponToggleButton"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/btn_outline"
            android:textColor="@color/hud_text"
            android:textSize="11sp"
            android:text="@string/weapon_he" />

        <TextView
            android:id="@+id/powerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="POWER 50"
            android:textColor="@color/neon_magenta"
            android:textStyle="bold"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/powerSeekBar"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:max="100"
            android:progress="50"
            android:progressDrawable="@drawable/seekbar_power" />
    </LinearLayout>

    <!-- Fire button center-right -->
    <Button
        android:id="@+id/fireButton"
        android:layout_width="78dp"
        android:layout_height="78dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="16dp"
        android:background="@drawable/btn_fire"
        android:text="@string/fire"
        android:textColor="@color/charcoal_slate_dark"
        android:textStyle="bold"
        android:textSize="13sp"
        android:visibility="invisible" />

    <!-- Game over panel -->
    <LinearLayout
        android:id="@+id/gameOverPanel"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_panel"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/resultText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/victory"
            android:textColor="@color/neon_cyan"
            android:textSize="26sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/playAgainButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/btn_outline"
            android:text="@string/play_again"
            android:textColor="@color/hud_text" />
    </LinearLayout>

</FrameLayout>
