<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/charcoal_slate_dark"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="@string/multiplayer"
        android:textColor="@color/neon_cyan"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/choose_transport"
        android:textColor="@color/hud_text"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="32dp">

        <Button
            android:id="@+id/bluetoothToggle"
            android:layout_width="140dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/btn_outline"
            android:text="@string/bluetooth"
            android:textColor="@color/neon_cyan"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/wifiDirectToggle"
            android:layout_width="140dp"
            android:layout_height="44dp"
            android:background="@drawable/btn_outline"
            android:text="@string/wifi_direct"
            android:textColor="@color/hud_text"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/hostGameButton"
        android:layout_width="220dp"
        android:layout_height="56dp"
        android:background="@drawable/btn_outline"
        android:text="@string/host_game"
        android:textColor="@color/hud_text"
        android:textStyle="bold" />

    <Button
        android:id="@+id/joinGameButton"
        android:layout_width="220dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/btn_outline"
        android:text="@string/join_game"
        android:textColor="@color/hud_text"
        android:textStyle="bold" />

</LinearLayout>
